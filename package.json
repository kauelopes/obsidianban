{
  "name": "obsidiankan-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter obsidiankan-mcp build",
    "build:plugin": "pnpm --filter @obsidiankan/plugin build",
    "test": "pnpm --filter obsidiankan-mcp test",
    "test:watch": "pnpm --filter obsidiankan-mcp test:watch",
    "test:coverage": "pnpm --filter obsidiankan-mcp test:coverage",
    "typecheck": "pnpm -r typecheck",
    "gen:tools": "pnpm --filter obsidiankan-mcp gen:tools"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
