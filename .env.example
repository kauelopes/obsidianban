# Absolute path to your Obsidian vault on the host.
# The MCP server reads and writes this directory directly on the host.
VAULT_PATH=/home/youruser/Documents/MyVault

# HTTP port for the Obsidian plugin, remote agents, SSE stream and metrics.
# Bound to 127.0.0.1 only — not exposed externally.
MCP_HTTP_PORT=9375

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Sprint workflow auto-launch (optional — set WORKFLOW_ENABLED=true to opt in)
# When enabled, kanban_start_sprint automatically spawns sprint-workflow.ts
# which drives a PM + dev agent loop until the sprint is done.
# Requires the 'claude' CLI on PATH and valid tokens below.
# ---------------------------------------------------------------------------

# WORKFLOW_ENABLED=true

# Absolute path to the workflow script. There is no default: when
# WORKFLOW_ENABLED=true and this is unset, auto-launch is silently disabled.
# The script is spawned with `node --import tsx`, so point at the .ts source —
# the build does not emit scripts/ (tsconfig rootDir is src).
# WORKFLOW_SCRIPT_PATH=/home/youruser/Projects/obsidianban/packages/server/scripts/sprint-workflow.ts

# The dev harness working directory is NOT set here — it comes from the
# project's target_repo, set per project via kanban_set_project_repo.

# Directory where per-sprint log files are written.
# WORKFLOW_LOG_DIR=/home/youruser/Documents/MyVault/.sprint-logs

# Anthropic API key used by the triage LLM and dev harness.
# ANTHROPIC_API_KEY=sk-ant-...

# Agent tokens — mint these once with kanban_create_agent_token via the manager.
# KANBAN_DEV_TOKEN=...
# KANBAN_PM_TOKEN=...
