    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@obsidiankan/types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
